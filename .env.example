# Configuração pública do app Web no Firebase.
# Estes valores identificam o projeto; a proteção real está no Auth e nas Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opção 1: upload direto com preset Unsigned (identificadores públicos).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Opção 2 (recomendada): assinatura temporária no servidor para usuários admin.
# Estas variáveis são privadas e nunca devem receber o prefixo VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNED_UPLOAD_PRESET=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_UPLOAD_PRESET=portfolio-unsigned

# O plano gratuito do Cloudinary aceita imagens de até 10 MB.
VITE_MAX_UPLOAD_MB=10

# Configuração privada da função /api/contact na Vercel. Não use prefixo VITE_.
# Envio principal pelo Private Email da Namecheap.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@jessicamontes.space
SMTP_PASSWORD=
CONTACT_EMAIL=contato@jessicamontes.space
SMTP_FROM_NAME=Portfólio da Jéssica

# Notificação opcional adicional pelo Discord.
DISCORD_WEBHOOK_URL=
DISCORD_CONTACT_USER_ID=1215077795651133479

# Assistente virtual via Groq. Nunca use prefixo VITE_: a chave deve ficar somente no servidor.
# O modelo padrão é o modelo de produção mais econômico disponível na integração.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
