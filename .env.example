# Configuração pública do app Web no Firebase.
# Estes valores identificam o projeto; a proteção real está no Auth e nas Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Upload direto e unsigned para o Cloudinary. Nunca coloque API Secret em variável VITE_*.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# O plano gratuito do Cloudinary aceita imagens de até 10 MB.
VITE_MAX_UPLOAD_MB=10

# Configuração privada da função /api/contact na Vercel. Não use prefixo VITE_.
DISCORD_WEBHOOK_URL=
DISCORD_CONTACT_USER_ID=1215077795651133479
